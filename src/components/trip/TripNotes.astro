---
// The trip's practical notes, all shown, in the same text column as the
// days. notes.md's "## sections" become <h3> subheadings (remark-notes.mjs).
import { render, type CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"tripText">;
}

const { Content } = await render(Astro.props.entry);
---

<section class="trip-notes" aria-labelledby="trip-notes-title">
  <h2 id="trip-notes-title">Trip notes</h2>
  <div class="prose notes">
    <Content />
  </div>
</section>

<style>
  .trip-notes {
    padding-top: clamp(4rem, 3rem + 4vw, 7rem);
  }

  h2 {
    text-align: center;
  }

  .notes {
    margin-top: 2rem;
  }

  /* Each note's heading: a step above the text, with room before it. */
  .notes :global(h3) {
    margin-top: 2.25rem;
    font-size: 1.25rem;
  }

  .notes :global(h3:first-child) {
    margin-top: 0;
  }
</style>
