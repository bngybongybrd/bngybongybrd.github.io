---
// The trip's practical notes. notes.md's "## sections" become collapsible
// cards (remark-notes-cards.mjs builds the <details> elements).
import { render, type CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"tripText">;
}

const { Content } = await render(Astro.props.entry);
---

<section class="trip-notes" aria-labelledby="trip-notes-title">
  <h2 id="trip-notes-title">Trip notes</h2>
  <div class="notes">
    <Content />
  </div>
</section>

<style>
  .trip-notes {
    padding-top: clamp(4rem, 3rem + 4vw, 7rem);
  }

  h2 {
    text-align: center;
  }

  .notes {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
</style>
