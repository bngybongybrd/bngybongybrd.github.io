---
// One day of a trip, opened like a chapter: "Day 2", the title, the date,
// all centred. Then an optional full-width cover photo, then the day's
// writing and media exactly as written.
import { Image } from "astro:assets";
import { render, type CollectionEntry } from "astro:content";
import { formatDayDate, isoDay } from "../../lib/format";

interface Props {
  entry: CollectionEntry<"days">;
}

const { entry } = Astro.props;
const { day, date, title, cover, coverAlt } = entry.data;
// render() turns the Markdown into HTML, running our remark/rehype plugins.
const { Content } = await render(entry);
---

<section class="day" id={`day-${day}`} aria-labelledby={`day-${day}-title`}>
  <header class="day-head">
    <p class="day-number">Day {day}</p>
    <h2 id={`day-${day}-title`}>{title}</h2>
    <p class="day-date"><time datetime={isoDay(date)}>{formatDayDate(date)}</time></p>
  </header>

  {
    cover && (
      <div class="day-cover">
        <Image src={cover} alt={coverAlt} layout="full-width" />
      </div>
    )
  }

  <div class="prose">
    <Content />
  </div>

  <p class="back-to-top"><a href="#trip-top">↑ back to top</a></p>
</section>

<style>
  .day {
    padding-top: clamp(4rem, 3rem + 4vw, 7rem);
  }

  .day-head {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .day-number {
    font-size: var(--text-sm);
    color: var(--accent-dark);
    letter-spacing: 0.04em;
  }

  h2 {
    margin-top: 0.4rem;
    font-size: clamp(1.875rem, 1.4rem + 2vw, 2.75rem);
  }

  .day-date {
    margin-top: 0.6rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* --- Cover: a wide band across the whole screen ---------------------------
     The photo is cropped to a band (object-fit: cover). Where the browser
     supports scroll-driven animations, the photo drifts slower than the page
     as you scroll past, so the band feels like a window onto the scene.
     Browsers without support, and readers who prefer reduced motion, get a
     still photo. */
  .day-cover {
    position: relative;
    height: min(75vh, 720px);
    margin: 0 calc(-1 * var(--gutter)) 3rem; /* cancel the page gutter */
    /* clip, not hidden: "hidden" makes this box a scroll container, and the
       scroll-driven animation would then track it instead of the page. */
    overflow: clip;
  }

  .day-cover :global(img) {
    width: 100%;
    max-width: none;
    height: 100%;
    object-fit: cover;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .day-cover :global(img) {
        /* 20% taller than the band, so it has room to move. */
        position: absolute;
        top: -10%;
        height: 120%;
        /* Longhands on purpose: the CSS minifier would otherwise merge them into
           an `animation` shorthand containing view(), which browsers reject. */
        animation-name: cover-drift;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view(); /* progress = the band crossing the screen */
      }

      @keyframes cover-drift {
        from {
          translate: 0 -8%;
        }
        to {
          translate: 0 8%;
        }
      }
    }
  }

  @media (max-width: 700px) {
    .day-cover {
      height: min(55vh, 420px);
    }
  }

  .back-to-top {
    margin-top: 3rem;
    text-align: center;
    font-size: var(--text-sm);
  }

  .back-to-top a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .back-to-top a:hover {
    color: var(--text);
  }
</style>
