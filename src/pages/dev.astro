---
// Developer page at /dev/: shows the fonts, colours and widths working.
// Not linked from the nav, and marked noindex so search engines skip it.
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="layout check" noindex>
  <section class="page reading check">
    <h1>Layout check</h1>
    <h2>Type and colour</h2>
    <p>
      Temporary test text so the reading column can be checked. Lorem ipsum dolor sit amet,
      consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna
      aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex
      ea commodo consequat.
    </p>
    <p>
      A <a href="/work/">normal link</a>, some <strong>bold text</strong>, inline <code>code</code>,
      and a Chinese run: <span lang="zh-Hans">云南</span>.
    </p>

    <h3>Colour tokens</h3>
    <ul class="swatches">
      {
        ["bg", "surface", "surface-2", "border", "border-2", "text", "text-muted", "text-faint", "accent", "accent-dark", "accent-light"].map(
          (name) => (
            <li>
              <span class="swatch" style={`background: var(--${name})`} />
              <code>--{name}</code>
            </li>
          ),
        )
      }
    </ul>
  </section>

  <section class="page wide check">
    <p class="label">wide layout (1000px)</p>
    <div class="wide-demo">
      <div></div>
      <div></div>
      <div></div>
    </div>
  </section>
</BaseLayout>

<style>
  .check h1,
  .check h2,
  .check h3 {
    margin-block: 0.5rem 1rem;
  }

  .check h3 {
    margin-top: 2rem;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 0.75rem;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .swatches li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .swatch {
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid var(--border-2);
    border-radius: var(--radius-sm);
    flex: none;
  }

  .wide-demo {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
    margin-top: 0.75rem;
  }

  .wide-demo div {
    height: 8rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
</style>
